<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Provides CONSOLE_LOG_PATTERN (which includes ${LOG_CORRELATION_PATTERN}
        from application.yml → logging.pattern.correlation), common log levels,
        and shared formatting properties.
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
        PII safety-net: registers %safeMsg as a custom conversion word.
        PiiRedactingConverter scans every formatted message for standalone
        7-or-8-digit sequences (Argentine DNI pattern) and replaces them
        with [DNI-REDACTED] before the line is written to the CONSOLE.

        This is a last-resort defence-in-depth measure. The primary control
        is PiiMaskingUtil used explicitly in every log statement that touches
        patient data.
    -->
    <conversionRule conversionWord="safeMsg"
                    class="wfederico.pneumacare.shared.logging.PiiRedactingConverter"/>

    <!--
        PII-safe console appender.
        Identical to Spring Boot's default CONSOLE appender but replaces
        %msg with %safeMsg so every log line passes through
        PiiRedactingConverter before being written to stdout.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN:-%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %safeMsg%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        OpenTelemetry Logback bridge.
        Forwards every LoggingEvent to the OTel Logs SDK, which exports them
        via OTLP HTTP to the /v1/logs endpoint configured in application.yml
        (management.otlp.logging.export.url).  The grafana/otel-lgtm collector
        receives these records and pushes them into Loki.

        captureCodeAttributes  – attaches logger name, source file and line number
                                 to every log record.
        captureMdcAttributes   – forwards traceId and spanId (populated by the
                                 Spring Boot / Micrometer tracing bridge) so that
                                 Loki can link a log line back to its Tempo trace.

        IMPORTANT: This appender calls ILoggingEvent.getFormattedMessage()
        directly and therefore bypasses PiiRedactingConverter.
        PII protection for OTel log records relies on PiiMaskingUtil being
        used explicitly in every log statement that touches patient data.
    -->
    <appender name="OpenTelemetry"
              class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureCodeAttributes>true</captureCodeAttributes>
        <captureMdcAttributes>traceId,spanId</captureMdcAttributes>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OpenTelemetry"/>
    </root>

</configuration>
