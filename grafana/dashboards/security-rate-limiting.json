    },
    {
      "title": "HTTP Latency p95 — All Endpoints",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
