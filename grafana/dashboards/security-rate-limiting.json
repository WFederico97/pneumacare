      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_milliseconds_count{job=\"pneumacare\", status=~\"5..\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} [{{status}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
