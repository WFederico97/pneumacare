        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(increase(http_server_requests_milliseconds_count{job=\"pneumacare\", status=~\"5..\"}[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
