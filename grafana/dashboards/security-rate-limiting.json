  "panels": [
    {
      "title": "HTTP Request Rate by Status Class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_milliseconds_count{job=\"pneumacare\", status=~\"2..\"}[1m]))",
          "legendFormat": "2xx",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_milliseconds_count{job=\"pneumacare\", status=~\"4..\"}[1m]))",
          "legendFormat": "4xx",
          "refId": "B"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_milliseconds_count{job=\"pneumacare\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "title": "4xx Errors by URI",
      "type": "timeseries",
