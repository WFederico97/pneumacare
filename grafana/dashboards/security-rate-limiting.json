          "legendFormat": "p95 {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      }
    },
    {
      "title": "Security Filter Chain Latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(spring_security_filterchains_milliseconds_bucket{job=\"pneumacare\"}[1m])) by (le))",
          "legendFormat": "p95 filter chain",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(spring_security_filterchains_milliseconds_bucket{job=\"pneumacare\"}[1m])) by (le))",
