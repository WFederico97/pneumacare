        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(jvm_memory_used_bytes{job=\"pneumacare\", area=\"nonheap\"}) by (id)",
          "legendFormat": "used · {{id}}",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(jvm_memory_committed_bytes{job=\"pneumacare\", area=\"nonheap\"}) by (id)",
          "legendFormat": "committed · {{id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    },
