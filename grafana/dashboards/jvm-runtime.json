          "legendFormat": "Process",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "system_cpu_usage{job=\"pneumacare\"}",
          "legendFormat": "System",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
