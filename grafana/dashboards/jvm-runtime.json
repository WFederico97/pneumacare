  "panels": [
    {
      "title": "Heap Memory — Used / Committed / Max",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(jvm_memory_used_bytes{job=\"pneumacare\", area=\"heap\"}) by (id)",
          "legendFormat": "used · {{id}}",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(jvm_memory_committed_bytes{job=\"pneumacare\", area=\"heap\"}) by (id)",
          "legendFormat": "committed · {{id}}",
          "refId": "B"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(jvm_memory_max_bytes{job=\"pneumacare\", area=\"heap\"}) by (id)",
          "legendFormat": "max · {{id}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    },
    {
      "title": "Non-Heap Memory — Used / Committed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
