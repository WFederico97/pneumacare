          "legendFormat": "p95 {{action}} / {{cause}}",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(jvm_gc_pause_milliseconds_bucket{job=\"pneumacare\"}[2m])) by (le, action, cause))",
          "legendFormat": "p50 {{action}} / {{cause}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      }
    },
    {
