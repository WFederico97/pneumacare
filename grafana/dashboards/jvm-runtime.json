    {
      "title": "GC Pause — Rate of pause time (ms/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
