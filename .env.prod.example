# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
# Generate the two crypto secrets with:
#   AES_SECRET_KEY  ->  openssl rand -base64 32     (must decode to exactly 32 bytes)
#   PNMC_JWT_SECRET ->  openssl rand -base64 48     (>= 256-bit)

# --- Database (a fresh DB; Flyway builds the schema on first boot) ---
DB_NAME=pneumacare
DB_USER=pneumacare
DB_PASSWORD=change-me-strong-password

# --- Security secrets ---
AES_SECRET_KEY=
PNMC_JWT_SECRET=
PNMC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# --- Web ---
# Comma-separated origins allowed by CORS (e.g. https://app.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Optional ---
BOOTSTRAP_ADMIN_USERNAME=admin
# Host port to publish the app on (container always listens on 8080).
HOST_PORT=8080
# KAFKA_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Demo dataset ---
# Seeds 6 demo patients + evaluations in a dedicated Demo ICU (medical-insights
# demo). Leave false for a clean production DB; set true to populate a demo.
DEMO_SEED_ENABLED=false
