# ========================
# Application
# ========================
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ========================
# PostgreSQL
# ========================
DB_HOST=postgres
DB_PORT=5432
# Host port exposed to your machine (use a different value to avoid conflicts with a local PostgreSQL).
# The app always connects internally on DB_PORT=5432; this only affects the Docker host binding.
DB_HOST_PORT=5432
DB_NAME=pneumacare_db
DB_USER=change_me
DB_PASSWORD=change_me

# ========================
# Redis
# ========================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=change_me   # Redis in compose has no requirepass; uncomment only if you add auth

# ========================
# Kafka
# ========================
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ========================
# Observability (OpenTelemetry)
# ========================
OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana-lgtm:4318
OTEL_SERVICE_NAME=pneumacare

# ========================
# Grafana
# ========================
# Admin credentials for the embedded Grafana inside grafana/otel-lgtm.
# GF_SECURITY_ADMIN_PASSWORD is required — no default is provided.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me

# Frontend port (angular nginx container, optional)
FRONTEND_PORT=4200

# ========================
# Security — PII Encryption (Law 25.326)
# ========================
# AES-256 secret key (32 bytes, Base64-encoded). REQUIRED — the application
# will refuse to start if this value is missing or invalid.
# Generate a fresh key with:   openssl rand -base64 32
AES_SECRET_KEY=change_me

# ========================
# Security (OAuth2)
# ========================
OAUTH2_ISSUER_URI=http://localhost:9000

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_THRESHOLD=10
RATE_LIMIT_WINDOW=60

# ========================
# Notifications — n8n webhook (PNMC-99)
# ========================
# Outbound patient-risk alert webhook. Leave N8N_WEBHOOK_URL blank to DISABLE
# dispatch (the app logs "webhook disabled — skipping" instead of erroring).
# Set it to your n8n Webhook node URL to enable alerts.
N8N_WEBHOOK_URL=
# Shared secret sent as the X-Webhook-Secret header (only when non-blank).
# Configure the same value in the n8n workflow to verify the sender.
N8N_WEBHOOK_SECRET=
# Connect/read timeouts. Spring Duration syntax (e.g. 3000ms, 3s).
N8N_WEBHOOK_CONNECT_TIMEOUT=3000ms
N8N_WEBHOOK_READ_TIMEOUT=3000ms

