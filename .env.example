# ========================
# Application
# ========================
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ========================
# PostgreSQL
# ========================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mi_base_de_datos
DB_USER=postgres
DB_PASSWORD=change_me

# ========================
# Redis
# ========================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# ========================
# Kafka
# ========================
KAFKA_BROKER=kafka:9092

# ========================
# Observability (OpenTelemetry)
# ========================
OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana-lgtm:4318
OTEL_SERVICE_NAME=my-microservice

# ========================
# Security (OAuth2)
# ========================
OAUTH2_ISSUER_URI=http://localhost:9000

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_THRESHOLD=10
RATE_LIMIT_WINDOW=60

