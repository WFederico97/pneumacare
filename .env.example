# ========================
# Application
# ========================
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ========================
# PostgreSQL
# ========================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pneumacare_db
DB_USER=change_me
DB_PASSWORD=change_me

# ========================
# Redis
# ========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# ========================
# Kafka
# ========================
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ========================
# Observability (OpenTelemetry)
# ========================
OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana-lgtm:4318
OTEL_SERVICE_NAME=pneumacare

# ========================
# Grafana
# ========================
# Admin credentials for the embedded Grafana inside grafana/otel-lgtm.
# GF_SECURITY_ADMIN_PASSWORD is required — no default is provided.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me

# Frontend port (angular nginx container, optional)
FRONTEND_PORT=4200

# ========================
# Security (OAuth2)
# ========================
OAUTH2_ISSUER_URI=http://localhost:9000

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_THRESHOLD=10
RATE_LIMIT_WINDOW=60

